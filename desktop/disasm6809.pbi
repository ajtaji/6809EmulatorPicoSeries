; A 6809 disassembler for the desktop core. The opcode table (disasm6809_table.pbi) is
; generated by tools/generate.py from the core's own handler list, so it names exactly the
; opcodes the core implements. CpuDisasm(addr) returns the text of the instruction at addr,
; read through the core's page tables with CpuRead8 (so an I/O page is READ - in a live
; machine keep the window away from the I/O page), and leaves its length in CpuDisasmLen.
; Undocumented opcodes read "?? $xx".
XIncludeFile "disasm6809_table.pbi"

Global CpuDisasmLen.i
Global Dim CpuDisMn.s(767)
Global Dim CpuDisMode.a(767)
Global CpuDisReady.i

Procedure CpuDisasmInit()
  Protected i.i, e$
  Restore CpuDisTable
  For i = 0 To 767
    Read.s e$
    CpuDisMn(i) = StringField(e$, 1, " ")
    CpuDisMode(i) = Val(StringField(e$, 2, " "))
  Next
  CpuDisReady = 1
EndProcedure

Procedure.s CpuDisHex(v.i, digits.i)
  ProcedureReturn "$" + RSet(Hex(v), digits, "0")
EndProcedure

Procedure.s CpuDisRegList(post.i, other$)
  Protected s$, names$ = "CC A B DP X Y " + other$ + " PC", k.i
  For k = 0 To 7
    If post & (1 << k)
      If s$ : s$ + "," : EndIf
      s$ + StringField(names$, k + 1, " ")
    EndIf
  Next
  ProcedureReturn s$
EndProcedure

Procedure.i CpuDisWord(a.i)
  ProcedureReturn (CpuRead8(a & $FFFF) << 8) | CpuRead8((a + 1) & $FFFF)
EndProcedure

Procedure.s CpuDisasm(addr.i)
  Protected op.i, page.i, mn$, mode.i, a.i, b.i, w.i, post.i, r$, s$, ind.i
  If CpuDisReady = 0 : CpuDisasmInit() : EndIf
  a = addr & $FFFF
  op = CpuRead8(a) : a + 1
  If op = $10 Or op = $11
    page = op - $0F
    op = CpuRead8(a & $FFFF) : a + 1
  EndIf
  mn$ = CpuDisMn(page * 256 + op) : mode = CpuDisMode(page * 256 + op)
  If mn$ = "?"
    CpuDisasmLen = a - (addr & $FFFF)
    If page : ProcedureReturn "?? " + CpuDisHex(page + $0F, 2) + " " + CpuDisHex(op, 2) : EndIf
    ProcedureReturn "?? " + CpuDisHex(op, 2)
  EndIf
  Select mode
    Case 1 : s$ = "#" + CpuDisHex(CpuRead8(a & $FFFF), 2) : a + 1
    Case 2 : s$ = "#" + CpuDisHex(CpuDisWord(a), 4) : a + 2
    Case 3 : s$ = "<" + CpuDisHex(CpuRead8(a & $FFFF), 2) : a + 1
    Case 4 : s$ = CpuDisHex(CpuDisWord(a), 4) : a + 2
    Case 6
      b = CpuRead8(a & $FFFF) : a + 1
      If b & $80 : b - 256 : EndIf
      s$ = CpuDisHex((a + b) & $FFFF, 4)
    Case 7
      w = CpuDisWord(a) : a + 2
      s$ = CpuDisHex((a + w) & $FFFF, 4)
    Case 8, 9
      post = CpuRead8(a & $FFFF) : a + 1
      If mode = 8 : s$ = CpuDisRegList(post, "U") : Else : s$ = CpuDisRegList(post, "S") : EndIf
    Case 10
      post = CpuRead8(a & $FFFF) : a + 1
      r$ = "D X Y U S PC ?6 ?7 A B CC DP ?C ?D ?E ?F"
      s$ = StringField(r$, (post >> 4) + 1, " ") + "," + StringField(r$, (post & 15) + 1, " ")
    Case 5
      post = CpuRead8(a & $FFFF) : a + 1
      r$ = StringField("X Y U S", ((post >> 5) & 3) + 1, " ")
      If (post & $80) = 0
        b = post & 31
        If b & 16 : b - 32 : EndIf
        s$ = Str(b) + "," + r$
      Else
        ind = post & $10
        Select post & 15
          Case 0 : s$ = "," + r$ + "+"
          Case 1 : s$ = "," + r$ + "++"
          Case 2 : s$ = ",-" + r$
          Case 3 : s$ = ",--" + r$
          Case 4 : s$ = "," + r$
          Case 5 : s$ = "B," + r$
          Case 6 : s$ = "A," + r$
          Case 8
            b = CpuRead8(a & $FFFF) : a + 1
            If b & $80 : b - 256 : EndIf
            s$ = Str(b) + "," + r$
          Case 9
            w = CpuDisWord(a) : a + 2
            If w & $8000 : w - 65536 : EndIf
            s$ = Str(w) + "," + r$
          Case 11 : s$ = "D," + r$
          Case 12
            b = CpuRead8(a & $FFFF) : a + 1
            If b & $80 : b - 256 : EndIf
            s$ = CpuDisHex((a + b) & $FFFF, 4) + ",PCR"
          Case 13
            w = CpuDisWord(a) : a + 2
            s$ = CpuDisHex((a + w) & $FFFF, 4) + ",PCR"
          Case 15
            w = CpuDisWord(a) : a + 2
            s$ = CpuDisHex(w, 4)
          Default
            s$ = "?postbyte " + CpuDisHex(post, 2)
        EndSelect
        If ind : s$ = "[" + s$ + "]" : EndIf
      EndIf
  EndSelect
  CpuDisasmLen = a - (addr & $FFFF)
  If s$ : ProcedureReturn LSet(mn$, 6) + s$ : EndIf
  ProcedureReturn mn$
EndProcedure
