Op12: ; $12 NOP inh
  NextOp2()
Op13: ; $13 SYNC inh
  If CpuNmiPending Or CpuFirqLine Or CpuIrqLine
    CutWindow()
    NextOp4()
  EndIf
  CpuSyncing = 1
  CutWindow()
  NextOp2()
Op16: ; $16 LBRA rel16
  RdW(CpuVal, CpuPC)
  CpuPC = CpuPC + 2
  CpuPC = (CpuPC + CpuVal) & $FFFF
  NextOp5()
Op17: ; $17 LBSR rel16
  RdW(CpuVal, CpuPC)
  CpuPC = CpuPC + 2
  Push16S(CpuPC)
  CpuPC = (CpuPC + CpuVal) & $FFFF
