Op00: ; $00 NEG dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = 0 - CpuVal
  CpuFC = CpuRes
  CpuFV = CpuVal ! CpuRes ! (CpuRes >> 1)
  CpuRes = CpuRes & 255
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op03: ; $03 COM dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = CpuVal ! 255
  CpuFV = 0
  CpuFC = $100
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op04: ; $04 LSR dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = CpuVal >> 1
  CpuFC = CpuVal << 8
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op06: ; $06 ROR dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal >> 1) | ((CpuFC & $100) >> 1)
  CpuFC = CpuVal << 8
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op07: ; $07 ASR dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal >> 1) | (CpuVal & $80)
  CpuFC = CpuVal << 8
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op08: ; $08 ASL dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = CpuVal << 1
  CpuFC = CpuRes
  CpuFV = CpuRes ! (CpuRes >> 1)
  CpuRes = CpuRes & 255
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op09: ; $09 ROL dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal << 1) | ((CpuFC >> 8) & 1)
  CpuFC = CpuRes
  CpuFV = CpuRes ! (CpuRes >> 1)
  CpuRes = CpuRes & 255
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op0A: ; $0A DEC dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal - 1) & 255
  CpuFV = (CpuVal ! CpuRes) & CpuVal
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op0C: ; $0C INC dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal + 1) & 255
  CpuFV = (CpuVal ! CpuRes) & CpuRes
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op0D: ; $0D TST dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuFV = 0
  CpuFN = CpuVal
  CpuFZ = CpuVal
  NextOp6()
Op0E: ; $0E JMP dir
