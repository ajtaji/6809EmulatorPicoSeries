  CpuFV = 0
  CpuFN = CpuVal >> 8
  CpuFZ = CpuVal
  NextOp6()
OpP2_EE: ; $10$EE LDS idx
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  ! cpu_ixcont = &&ll_cpurun_opp2_ee_ea;
  ! goto *cpu_ix[g_cpupost];
OpP2_EE_ea:
  RdW(CpuVal, CpuEa)
  CpuFV = 0
  CpuFN = CpuVal >> 8
  CpuFZ = CpuVal
  CpuS = CpuVal
  CpuNmiArmed = 1
  NextOp6()
