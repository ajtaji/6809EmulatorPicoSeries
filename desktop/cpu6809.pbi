  CpuLeft = n
  CpuCut = 0
Resume:
  If CpuStopped
    Goto Finish
  EndIf
  If CpuSyncing
    If CpuNmiPending Or CpuFirqLine Or CpuIrqLine
      CpuSyncing = 0
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 2
      CompilerEndIf
    Else
      CpuLeft = 0
      Goto Finish
    EndIf
  EndIf
  If CpuNmiPending
    CpuNmiPending = 0
    CpuTmp = $FFFC
    CpuVal = 1
  ElseIf CpuFirqLine And CpuFF = 0
    CpuTmp = $FFF6
    CpuVal = 1
  ElseIf CpuIrqLine And CpuFI = 0
    CpuTmp = $FFF8
    CpuVal = 0
  Else
    If CpuWaiting
      CpuLeft = 0
      Goto Finish
    EndIf
    DispatchNext()
  EndIf
  ; take the interrupt (CpuTmp = vector, CpuVal = 1 also masks FIRQ)
  If CpuWaiting
    CpuWaiting = 0
    CompilerIf #CPU_TIMING = 1
      CpuLeft = CpuLeft - 4
    CompilerEndIf
  ElseIf CpuTmp = $FFF6
    CpuFE = 0
    Push16S(CpuPC)
    Push8S(CpuGetCC())
    CompilerIf #CPU_TIMING = 1
      CpuLeft = CpuLeft - 10
    CompilerEndIf
  Else
    CpuFE = 1
    CpuPushAll()
    CompilerIf #CPU_TIMING = 1
      CpuLeft = CpuLeft - 19
    CompilerEndIf
  EndIf
  CpuFI = 1
  If CpuVal
    CpuFF = 1
  EndIf
  RdW(CpuPC, CpuTmp)
  ; at least one instruction follows an interrupt entry, as the silicon does
  CompilerIf #CPU_TIMING = 1
    If CpuLeft <= 0
      CpuCut = CpuCut + CpuLeft - 1
      CpuLeft = 1
    EndIf
  CompilerEndIf
  DispatchNext()
