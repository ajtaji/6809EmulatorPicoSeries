  CpuPC = CpuPC + 2
  RdW(CpuVal, CpuEa)
  CpuFV = 0
  CpuFN = CpuVal >> 8
  CpuFZ = CpuVal
  CpuY = CpuVal
  NextOp7()
OpP2_BF: ; $10$BF STY ext
  RdW(CpuEa, CpuPC)
  CpuPC = CpuPC + 2
  CpuVal = CpuY
  WrW(CpuEa, CpuVal)
  CpuFV = 0
  CpuFN = CpuVal >> 8
  CpuFZ = CpuVal
  NextOp7()
OpP2_CE: ; $10$CE LDS imm
  RdW(CpuVal, CpuPC)
  CpuPC = CpuPC + 2
  CpuFV = 0
  CpuFN = CpuVal >> 8
  CpuFZ = CpuVal
  CpuS = CpuVal
  CpuNmiArmed = 1
  NextOp4()
OpP2_DE: ; $10$DE LDS dir
  RdB(CpuEa, CpuPC)
