  CpuFC = CpuRes >> 8
  CpuFV = (CpuTmp ! CpuVal ! CpuRes ! (CpuRes >> 1)) >> 8
  CpuRes = CpuRes & $FFFF
  CpuFN = CpuRes >> 8
  CpuFZ = CpuRes
  NextOp7()
OpP3_AC: ; $11$AC CMPS idx
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  ! cpu_ixcont = &&ll_cpurun_opp3_ac_ea;
  ! goto *cpu_ix[g_cpupost];
OpP3_AC_ea:
  RdW(CpuVal, CpuEa)
  CpuTmp = CpuS
  CpuRes = CpuTmp - CpuVal
  CpuFC = CpuRes >> 8
  CpuFV = (CpuTmp ! CpuVal ! CpuRes ! (CpuRes >> 1)) >> 8
  CpuRes = CpuRes & $FFFF
  CpuFN = CpuRes >> 8
  CpuFZ = CpuRes
  NextOp7()
OpP3_B3: ; $11$B3 CMPU ext
  RdW(CpuEa, CpuPC)
  CpuPC = CpuPC + 2
  RdW(CpuVal, CpuEa)
  CpuTmp = CpuU
  CpuRes = CpuTmp - CpuVal
  CpuFC = CpuRes >> 8
  CpuFV = (CpuTmp ! CpuVal ! CpuRes ! (CpuRes >> 1)) >> 8
  CpuRes = CpuRes & $FFFF
  CpuFN = CpuRes >> 8
  CpuFZ = CpuRes
  NextOp8()
OpP3_BC: ; $11$BC CMPS ext
  RdW(CpuEa, CpuPC)
  CpuPC = CpuPC + 2
  RdW(CpuVal, CpuEa)
  CpuTmp = CpuS
  CpuRes = CpuTmp - CpuVal
  CpuFC = CpuRes >> 8
  CpuFV = (CpuTmp ! CpuVal ! CpuRes ! (CpuRes >> 1)) >> 8
  CpuRes = CpuRes & $FFFF
  CpuFN = CpuRes >> 8
  CpuFZ = CpuRes
  NextOp8()
Done:
  If CpuCut
    CpuLeft = CpuLeft + CpuCut
    CpuCut = 0
    If CpuLeft > 0
      Goto Resume
    EndIf
  EndIf
Finish:
  CpuPC = CpuPC & $FFFF
  CpuTmp = CpuBudget - CpuLeft
  CpuBudget = 0
  CompilerIf #CPU_TIMING = 1
    CpuCycles = CpuCycles + CpuTmp
  CompilerEndIf
  ProcedureReturn CpuTmp
EndProcedure
