  CpuFV = 0
  CpuFN = CpuVal >> 8
  CpuFZ = CpuVal
  CpuS = CpuVal
  CpuNmiArmed = 1
  NextOp7()
OpP2_FF: ; $10$FF STS ext
  RdW(CpuEa, CpuPC)
  CpuPC = CpuPC + 2
  CpuVal = CpuS
  WrW(CpuEa, CpuVal)
  CpuFV = 0
  CpuFN = CpuVal >> 8
  CpuFZ = CpuVal
  NextOp7()
OpP3_3F: ; $11$3F SWI3 inh
  CpuFE = 1
  CpuPushAll()
  RdW(CpuPC, $FFF2)
  NextOp20()
OpP3_83: ; $11$83 CMPU imm
  RdW(CpuVal, CpuPC)
  CpuPC = CpuPC + 2
  CpuTmp = CpuU
  CpuRes = CpuTmp - CpuVal
  CpuFC = CpuRes >> 8
  CpuFV = (CpuTmp ! CpuVal ! CpuRes ! (CpuRes >> 1)) >> 8
  CpuRes = CpuRes & $FFFF
  CpuFN = CpuRes >> 8
  CpuFZ = CpuRes
  NextOp5()
OpP3_8C: ; $11$8C CMPS imm
  RdW(CpuVal, CpuPC)
  CpuPC = CpuPC + 2
  CpuTmp = CpuS
  CpuRes = CpuTmp - CpuVal
  CpuFC = CpuRes >> 8
  CpuFV = (CpuTmp ! CpuVal ! CpuRes ! (CpuRes >> 1)) >> 8
  CpuRes = CpuRes & $FFFF
  CpuFN = CpuRes >> 8
  CpuFZ = CpuRes
  NextOp5()
OpP3_93: ; $11$93 CMPU dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdW(CpuVal, CpuEa)
  CpuTmp = CpuU
  CpuRes = CpuTmp - CpuVal
  CpuFC = CpuRes >> 8
  CpuFV = (CpuTmp ! CpuVal ! CpuRes ! (CpuRes >> 1)) >> 8
  CpuRes = CpuRes & $FFFF
  CpuFN = CpuRes >> 8
  CpuFZ = CpuRes
  NextOp7()
OpP3_9C: ; $11$9C CMPS dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdW(CpuVal, CpuEa)
  CpuTmp = CpuS
  CpuRes = CpuTmp - CpuVal
  CpuFC = CpuRes >> 8
  CpuFV = (CpuTmp ! CpuVal ! CpuRes ! (CpuRes >> 1)) >> 8
  CpuRes = CpuRes & $FFFF
  CpuFN = CpuRes >> 8
  CpuFZ = CpuRes
  NextOp7()
OpP3_A3: ; $11$A3 CMPU idx
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  ! cpu_ixcont = &&ll_cpurun_opp3_a3_ea;
