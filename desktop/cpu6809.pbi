Op19: ; $19 DAA inh
  CpuVal = 0
  If (CpuA & 15) >= 10 Or (CpuFH & $10) <> 0
    CpuVal = 6
  EndIf
  If CpuA >= $90 And (CpuA & 15) >= 10
    CpuVal = CpuVal | $60
  EndIf
  If CpuA >= $A0 Or (CpuFC & $100) <> 0
    CpuVal = CpuVal | $60
  EndIf
  CpuRes = CpuA + CpuVal
  CpuFC = CpuFC | CpuRes
  CpuA = CpuRes & 255
  CpuFN = CpuA
  CpuFZ = CpuA
  CpuFV = CpuA ! ((CpuFC >> 1) & $80)
  NextOp2()
Op1A: ; $1A ORCC imm
  RdB(CpuVal, CpuPC)
  CpuPC = CpuPC + 1
  CpuSetCC(CpuGetCC() | CpuVal)
  NextOp3()
Op1C: ; $1C ANDCC imm
  RdB(CpuVal, CpuPC)
  CpuPC = CpuPC + 1
  If (CpuFI And (CpuVal & $10) = 0) Or (CpuFF And (CpuVal & $40) = 0)
    CutWindow()
  EndIf
  CpuSetCC(CpuGetCC() & CpuVal)
  NextOp3()
Op1D: ; $1D SEX inh
  CpuA = 0
  If CpuB & $80
    CpuA = 255
  EndIf
  CpuFN = CpuA
  CpuFZ = CpuB
  NextOp2()
Op1E: ; $1E EXG imm
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuTransfer(CpuPost, 1)
  NextOp8()
Op1F: ; $1F TFR imm
