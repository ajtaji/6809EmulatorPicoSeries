  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 6
  CompilerEndIf
  Goto CpuIxCont
IxF2: ; indexed postbyte $F2
  CpuS = (CpuS - 1) & $FFFF
  CpuEa = CpuS
  CpuNmiArmed = 1
  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 5
  CompilerEndIf
  Goto CpuIxCont
IxF3: ; indexed postbyte $F3
  CpuS = (CpuS - 2) & $FFFF
  CpuEa = CpuS
  CpuNmiArmed = 1
  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 6
  CompilerEndIf
  Goto CpuIxCont
IxF4: ; indexed postbyte $F4
  CpuEa = CpuS
  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 3
  CompilerEndIf
  Goto CpuIxCont
IxF5: ; indexed postbyte $F5
  CpuEa = (CpuS + ((CpuB ! 128) - 128)) & $FFFF
  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 4
  CompilerEndIf
  Goto CpuIxCont
IxF6: ; indexed postbyte $F6
  CpuEa = (CpuS + ((CpuA ! 128) - 128)) & $FFFF
  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 4
  CompilerEndIf
  Goto CpuIxCont
IxF7: ; indexed postbyte $F7
  CpuEa = (CpuS + ((CpuA ! 128) - 128)) & $FFFF
  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 4
  CompilerEndIf
  Goto CpuIxCont
IxF8: ; indexed postbyte $F8
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = (CpuS + ((CpuEa ! 128) - 128)) & $FFFF
  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 4
  CompilerEndIf
  Goto CpuIxCont
IxF9: ; indexed postbyte $F9
  RdW(CpuEa, CpuPC)
  CpuPC = CpuPC + 2
  CpuEa = (CpuS + CpuEa) & $FFFF
  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 7
  CompilerEndIf
  Goto CpuIxCont
IxFB: ; indexed postbyte $FB
  CpuEa = (CpuS + ((CpuA << 8) | CpuB)) & $FFFF
  RdW(CpuEa, CpuEa)
  CompilerIf #CPU_TIMING = 1
    CpuLeft = CpuLeft - 7
  CompilerEndIf
  Goto CpuIxCont
Op00: ; $00 NEG dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = 0 - CpuVal
  CpuFC = CpuRes
  CpuFV = CpuVal ! CpuRes ! (CpuRes >> 1)
  CpuRes = CpuRes & 255
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op03: ; $03 COM dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = CpuVal ! 255
  CpuFV = 0
  CpuFC = $100
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op04: ; $04 LSR dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = CpuVal >> 1
  CpuFC = CpuVal << 8
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op06: ; $06 ROR dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal >> 1) | ((CpuFC & $100) >> 1)
  CpuFC = CpuVal << 8
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op07: ; $07 ASR dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal >> 1) | (CpuVal & $80)
  CpuFC = CpuVal << 8
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op08: ; $08 ASL dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = CpuVal << 1
  CpuFC = CpuRes
  CpuFV = CpuRes ! (CpuRes >> 1)
  CpuRes = CpuRes & 255
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op09: ; $09 ROL dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal << 1) | ((CpuFC >> 8) & 1)
  CpuFC = CpuRes
  CpuFV = CpuRes ! (CpuRes >> 1)
  CpuRes = CpuRes & 255
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op0A: ; $0A DEC dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal - 1) & 255
  CpuFV = (CpuVal ! CpuRes) & CpuVal
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op0C: ; $0C INC dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = (CpuVal + 1) & 255
  CpuFV = (CpuVal ! CpuRes) & CpuRes
  CpuFN = CpuRes
  CpuFZ = CpuRes
  WrB(CpuEa, CpuRes)
  NextOp6()
Op0D: ; $0D TST dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuFV = 0
  CpuFN = CpuVal
  CpuFZ = CpuVal
  NextOp6()
Op0E: ; $0E JMP dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  CpuPC = CpuEa
  NextOp3()
Op0F: ; $0F CLR dir
  RdB(CpuEa, CpuPC)
  CpuPC = CpuPC + 1
  CpuEa = CpuEa | CpuDPage
  RdB(CpuVal, CpuEa)
  CpuRes = 0
  CpuFN = 0
  CpuFZ = 0
  CpuFV = 0
  CpuFC = 0
  WrB(CpuEa, CpuRes)
  NextOp6()
Op10: ; $10 PAGE2 prefix
  RdB(CpuTmp, CpuPC)
  CpuPC = CpuPC + 1
  Goto Dispatch2(CpuTmp)
Op11: ; $11 PAGE3 prefix
  RdB(CpuTmp, CpuPC)
  CpuPC = CpuPC + 1
  Goto Dispatch3(CpuTmp)
Op12: ; $12 NOP inh
  NextOp2()
Op13: ; $13 SYNC inh
  If CpuNmiPending Or CpuFirqLine Or CpuIrqLine
    CutWindow()
    NextOp4()
  EndIf
  CpuSyncing = 1
  CutWindow()
  NextOp2()
Op16: ; $16 LBRA rel16
  RdW(CpuVal, CpuPC)
  CpuPC = CpuPC + 2
  CpuPC = (CpuPC + CpuVal) & $FFFF
  NextOp5()
Op17: ; $17 LBSR rel16
  RdW(CpuVal, CpuPC)
  CpuPC = CpuPC + 2
  Push16S(CpuPC)
  CpuPC = (CpuPC + CpuVal) & $FFFF
  NextOp9()
Op19: ; $19 DAA inh
  CpuVal = 0
  If (CpuA & 15) >= 10 Or (CpuFH & $10) <> 0
    CpuVal = 6
  EndIf
  If CpuA >= $90 And (CpuA & 15) >= 10
    CpuVal = CpuVal | $60
  EndIf
  If CpuA >= $A0 Or (CpuFC & $100) <> 0
    CpuVal = CpuVal | $60
  EndIf
  CpuRes = CpuA + CpuVal
  CpuFC = CpuFC | CpuRes
  CpuA = CpuRes & 255
  CpuFN = CpuA
  CpuFZ = CpuA
  CpuFV = CpuA ! ((CpuFC >> 1) & $80)
  NextOp2()
Op1A: ; $1A ORCC imm
  RdB(CpuVal, CpuPC)
  CpuPC = CpuPC + 1
  CpuSetCC(CpuGetCC() | CpuVal)
  NextOp3()
Op1C: ; $1C ANDCC imm
  RdB(CpuVal, CpuPC)
  CpuPC = CpuPC + 1
  If (CpuFI And (CpuVal & $10) = 0) Or (CpuFF And (CpuVal & $40) = 0)
    CutWindow()
  EndIf
  CpuSetCC(CpuGetCC() & CpuVal)
  NextOp3()
Op1D: ; $1D SEX inh
  CpuA = 0
  If CpuB & $80
    CpuA = 255
  EndIf
  CpuFN = CpuA
  CpuFZ = CpuB
  NextOp2()
Op1E: ; $1E EXG imm
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuTransfer(CpuPost, 1)
  NextOp8()
Op1F: ; $1F TFR imm
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuTransfer(CpuPost, 0)
  NextOp6()
Op20: ; $20 BRA rel8
  RdSB(CpuVal, CpuPC)
  CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  NextOp3()
Op21: ; $21 BRN rel8
  CpuPC = CpuPC + 1
  NextOp3()
Op22: ; $22 BHI rel8
  If (CpuFC & $100) = 0 And CpuFZ <> 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op23: ; $23 BLS rel8
  If (CpuFC & $100) <> 0 Or CpuFZ = 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op24: ; $24 BCC rel8
  If (CpuFC & $100) = 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op25: ; $25 BCS rel8
  If (CpuFC & $100) <> 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op26: ; $26 BNE rel8
  If CpuFZ <> 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op27: ; $27 BEQ rel8
  If CpuFZ = 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op28: ; $28 BVC rel8
  If (CpuFV & $80) = 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op29: ; $29 BVS rel8
  If (CpuFV & $80) <> 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op2A: ; $2A BPL rel8
  If (CpuFN & $80) = 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op2B: ; $2B BMI rel8
  If (CpuFN & $80) <> 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op2C: ; $2C BGE rel8
  If ((CpuFN ! CpuFV) & $80) = 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op2D: ; $2D BLT rel8
  If ((CpuFN ! CpuFV) & $80) <> 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op2E: ; $2E BGT rel8
  If ((CpuFN ! CpuFV) & $80) = 0 And CpuFZ <> 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op2F: ; $2F BLE rel8
  If ((CpuFN ! CpuFV) & $80) <> 0 Or CpuFZ = 0
    RdSB(CpuVal, CpuPC)
    CpuPC = (CpuPC + 1 + CpuVal) & $FFFF
  Else
    CpuPC = CpuPC + 1
  EndIf
  NextOp3()
Op30: ; $30 LEAX idx
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuIxCont = ?Op30_ea
  Goto IxTab(CpuPost)
Op30_ea:
  CpuX = CpuEa
  CpuFZ = CpuEa
  NextOp4()
Op31: ; $31 LEAY idx
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuIxCont = ?Op31_ea
  Goto IxTab(CpuPost)
Op31_ea:
  CpuY = CpuEa
  CpuFZ = CpuEa
  NextOp4()
Op32: ; $32 LEAS idx
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuIxCont = ?Op32_ea
  Goto IxTab(CpuPost)
Op32_ea:
  CpuS = CpuEa
  CpuNmiArmed = 1
  NextOp4()
Op33: ; $33 LEAU idx
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuIxCont = ?Op33_ea
  Goto IxTab(CpuPost)
Op33_ea:
  CpuU = CpuEa
  NextOp4()
Op34: ; $34 PSHS imm
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuTmp = CpuPshCount(CpuPost)
  CpuEa = CpuS - CpuTmp
  If CpuEa >= 0 And (CpuEa >> 8) = ((CpuS - 1) >> 8)
    CpuPg = CpuWrMap(CpuEa >> 8)
  Else
    CpuPg = 0
  EndIf
  If CpuPg And CpuTmp
    CpuPg = CpuPg + CpuS
    If CpuPost & $80
      CpuPg = CpuPg - 2
      PokeA(CpuPg, CpuPC >> 8)
      PokeA(CpuPg + 1, CpuPC)
    EndIf
    If CpuPost & $40
      CpuPg = CpuPg - 2
      PokeA(CpuPg, CpuU >> 8)
      PokeA(CpuPg + 1, CpuU)
    EndIf
    If CpuPost & $20
      CpuPg = CpuPg - 2
      PokeA(CpuPg, CpuY >> 8)
      PokeA(CpuPg + 1, CpuY)
    EndIf
    If CpuPost & $10
      CpuPg = CpuPg - 2
      PokeA(CpuPg, CpuX >> 8)
      PokeA(CpuPg + 1, CpuX)
    EndIf
    If CpuPost & $08
      CpuPg = CpuPg - 1
      PokeA(CpuPg, CpuDPage >> 8)
    EndIf
    If CpuPost & $04
      CpuPg = CpuPg - 1
      PokeA(CpuPg, CpuB)
    EndIf
    If CpuPost & $02
      CpuPg = CpuPg - 1
      PokeA(CpuPg, CpuA)
    EndIf
    If CpuPost & $01
      CpuPg = CpuPg - 1
      PokeA(CpuPg, CpuGetCC())
    EndIf
    CpuS = CpuEa
    CompilerIf #CPU_TIMING = 1
      CpuLeft = CpuLeft - CpuTmp
    CompilerEndIf
  Else
    If CpuPost & $80
      Push16S(CpuPC)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 2
      CompilerEndIf
    EndIf
    If CpuPost & $40
      Push16S(CpuU)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 2
      CompilerEndIf
    EndIf
    If CpuPost & $20
      Push16S(CpuY)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 2
      CompilerEndIf
    EndIf
    If CpuPost & $10
      Push16S(CpuX)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 2
      CompilerEndIf
    EndIf
    If CpuPost & $08
      Push8S(CpuDPage >> 8)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 1
      CompilerEndIf
    EndIf
    If CpuPost & $04
      Push8S(CpuB)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 1
      CompilerEndIf
    EndIf
    If CpuPost & $02
      Push8S(CpuA)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 1
      CompilerEndIf
    EndIf
    If CpuPost & $01
      Push8S(CpuGetCC())
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 1
      CompilerEndIf
    EndIf
  EndIf
  CpuNmiArmed = 1
  NextOp5()
Op35: ; $35 PULS imm
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuTmp = CpuPshCount(CpuPost)
  CpuEa = CpuS + CpuTmp
  If CpuEa <= $10000 And (CpuS >> 8) = ((CpuEa - 1) >> 8)
    CpuPg = CpuRdMap(CpuS >> 8)
  Else
    CpuPg = 0
  EndIf
  If CpuPg And CpuTmp
    CpuPg = CpuPg + CpuS
    If CpuPost & $01
      CpuSetCC(PeekA(CpuPg))
      CutWindow()
      CpuPg = CpuPg + 1
    EndIf
    If CpuPost & $02
      CpuA = PeekA(CpuPg)
      CpuPg = CpuPg + 1
    EndIf
    If CpuPost & $04
      CpuB = PeekA(CpuPg)
      CpuPg = CpuPg + 1
    EndIf
    If CpuPost & $08
      CpuDPage = PeekA(CpuPg) << 8
      CpuPg = CpuPg + 1
    EndIf
    If CpuPost & $10
      CpuX = (PeekA(CpuPg) << 8) | PeekA(CpuPg + 1)
      CpuPg = CpuPg + 2
    EndIf
    If CpuPost & $20
      CpuY = (PeekA(CpuPg) << 8) | PeekA(CpuPg + 1)
      CpuPg = CpuPg + 2
    EndIf
    If CpuPost & $40
      CpuU = (PeekA(CpuPg) << 8) | PeekA(CpuPg + 1)
      CpuPg = CpuPg + 2
    EndIf
    If CpuPost & $80
      CpuPC = (PeekA(CpuPg) << 8) | PeekA(CpuPg + 1)
      CpuPg = CpuPg + 2
    EndIf
    CpuS = CpuEa & $FFFF
    CompilerIf #CPU_TIMING = 1
      CpuLeft = CpuLeft - CpuTmp
    CompilerEndIf
  Else
    If CpuPost & $01
      Pull8S(CpuVal)
      CpuSetCC(CpuVal)
      CutWindow()
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 1
      CompilerEndIf
    EndIf
    If CpuPost & $02
      Pull8S(CpuA)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 1
      CompilerEndIf
    EndIf
    If CpuPost & $04
      Pull8S(CpuB)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 1
      CompilerEndIf
    EndIf
    If CpuPost & $08
      Pull8S(CpuVal)
      CpuDPage = CpuVal << 8
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 1
      CompilerEndIf
    EndIf
    If CpuPost & $10
      Pull16S(CpuX)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 2
      CompilerEndIf
    EndIf
    If CpuPost & $20
      Pull16S(CpuY)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 2
      CompilerEndIf
    EndIf
    If CpuPost & $40
      Pull16S(CpuU)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 2
      CompilerEndIf
    EndIf
    If CpuPost & $80
      Pull16S(CpuPC)
      CompilerIf #CPU_TIMING = 1
        CpuLeft = CpuLeft - 2
      CompilerEndIf
    EndIf
  EndIf
  CpuNmiArmed = 1
  NextOp5()
Op36: ; $36 PSHU imm
  RdB(CpuPost, CpuPC)
  CpuPC = CpuPC + 1
  CpuTmp = CpuPshCount(CpuPost)
  CpuEa = CpuU - CpuTmp
  If CpuEa >= 0 And (CpuEa >> 8) = ((CpuU - 1) >> 8)
    CpuPg = CpuWrMap(CpuEa >> 8)
  Else
    CpuPg = 0
  EndIf
  If CpuPg And CpuTmp
    CpuPg = CpuPg + CpuU
    If CpuPost & $80
      CpuPg = CpuPg - 2
      PokeA(CpuPg, CpuPC >> 8)
      PokeA(CpuPg + 1, CpuPC)
    EndIf
    If CpuPost & $40
      CpuPg = CpuPg - 2
      PokeA(CpuPg, CpuS >> 8)
      PokeA(CpuPg + 1, CpuS)
    EndIf
    If CpuPost & $20
      CpuPg = CpuPg - 2
      PokeA(CpuPg, CpuY >> 8)
      PokeA(CpuPg + 1, CpuY)
    EndIf
    If CpuPost & $10
      CpuPg = CpuPg - 2
      PokeA(CpuPg, CpuX >> 8)
      PokeA(CpuPg + 1, CpuX)
    EndIf
    If CpuPost & $08
      CpuPg = CpuPg - 1
